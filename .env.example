# Copy to .env.production.local (not committed) and fill in. All values are
# read at build time and baked into the static files.

# Live domain, no trailing slash. Leave unset for a preview build: pages and
# robots.txt then tell search engines not to index the site.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (G-…) or Google Ads (AW-…) ID. WhatsApp and call clicks
# are sent as generate_lead events.
NEXT_PUBLIC_GA_ID=

# Optional: AW-…/label to count those clicks as Google Ads conversions.
NEXT_PUBLIC_ADS_CONVERSION=

# Google Search Console HTML-tag verification code (the content="…" value).
NEXT_PUBLIC_GSC_VERIFICATION=
